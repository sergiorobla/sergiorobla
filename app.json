{
  "expo": {
    "name": "Sergio Robla | Full-Stack Developer",
    "slug": "sergiorobla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
